{"ast":null,"code":"import{useEffect,useRef,useState}from'react';export function useInView(){let threshold=arguments.length>0&&arguments[0]!==undefined?arguments[0]:0.1;const ref=useRef(null);const[inView,setInView]=useState(false);useEffect(()=>{const el=ref.current;if(!el)return;const observer=new IntersectionObserver(_ref=>{let[entry]=_ref;if(entry.isIntersecting){setInView(true);observer.disconnect();}},{threshold});observer.observe(el);return()=>observer.disconnect();},[threshold]);return[ref,inView];}","map":{"version":3,"names":["useEffect","useRef","useState","useInView","threshold","arguments","length","undefined","ref","inView","setInView","el","current","observer","IntersectionObserver","_ref","entry","isIntersecting","disconnect","observe"],"sources":["E:/CodeWhisper/codewhisper-website/src/hooks/useInView.ts"],"sourcesContent":["import { useEffect, useRef, useState, RefObject } from 'react';\r\n\r\nexport function useInView(threshold = 0.1): [RefObject<HTMLDivElement>, boolean] {\r\n  const ref = useRef<HTMLDivElement>(null);\r\n  const [inView, setInView] = useState(false);\r\n\r\n  useEffect(() => {\r\n    const el = ref.current;\r\n    if (!el) return;\r\n    const observer = new IntersectionObserver(\r\n      ([entry]) => {\r\n        if (entry.isIntersecting) {\r\n          setInView(true);\r\n          observer.disconnect();\r\n        }\r\n      },\r\n      { threshold }\r\n    );\r\n    observer.observe(el);\r\n    return () => observer.disconnect();\r\n  }, [threshold]);\r\n\r\n  return [ref, inView];\r\n}\r\n"],"mappings":"AAAA,OAASA,SAAS,CAAEC,MAAM,CAAEC,QAAQ,KAAmB,OAAO,CAE9D,MAAO,SAAS,CAAAC,SAASA,CAAA,CAAwD,IAAvD,CAAAC,SAAS,CAAAC,SAAA,CAAAC,MAAA,IAAAD,SAAA,MAAAE,SAAA,CAAAF,SAAA,IAAG,GAAG,CACvC,KAAM,CAAAG,GAAG,CAAGP,MAAM,CAAiB,IAAI,CAAC,CACxC,KAAM,CAACQ,MAAM,CAAEC,SAAS,CAAC,CAAGR,QAAQ,CAAC,KAAK,CAAC,CAE3CF,SAAS,CAAC,IAAM,CACd,KAAM,CAAAW,EAAE,CAAGH,GAAG,CAACI,OAAO,CACtB,GAAI,CAACD,EAAE,CAAE,OACT,KAAM,CAAAE,QAAQ,CAAG,GAAI,CAAAC,oBAAoB,CACvCC,IA